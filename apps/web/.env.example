# Site public (port 3000)
DATABASE_URL="postgresql://user:password@localhost:5432/netcine"

# Secret de signature des sessions spectateurs (générer : openssl rand -base64 32)
# Peut être différent de celui de l'admin (recommandé).
AUTH_SECRET="change-me-with-a-long-random-string"

# URL publique du site (utilisée pour le retour de paiement)
SITE_URL="http://localhost:3000"

# Paiement FedaPay (laisser vide = pas de paiement en ligne, mode manuel seulement)
# Clé secrète : FedaPay > Paramètres > Clés API. sandbox = tests, live = argent réel.
FEDAPAY_SECRET_KEY=""
FEDAPAY_ENV="sandbox"
