# Espace admin (port 3001) — même base de données que le site
DATABASE_URL="postgresql://user:password@localhost:5432/netcine"

# Secret de signature de la session admin (générer : openssl rand -base64 32)
AUTH_SECRET="change-me-with-a-long-random-string"

# Adresse publique du site (liens « Voir sur le site »)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Stockage objet compatible S3 (Cloudflare R2, Bunny Storage S3, AWS S3, MinIO...)
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="netcine"
S3_ACCESS_KEY="..."
S3_SECRET_KEY="..."
# URL publique de lecture (domaine du bucket ou CDN), sans slash final
S3_PUBLIC_URL="https://cdn.example.com"
